<?xml version="1.0" encoding="utf-8"?>
<full-backup-content xmlns:tools="http://schemas.android.com/tools">
  <!-- 699D-M: No implicit restoration of stale WebView/localStorage, IndexedDB,
       encrypted local vault, auth/session or revision metadata.
       Reinstall must start clean and restore synced data through LubaServer.
       Local-only notes require a user-controlled export before uninstall. -->
  <exclude domain="root" path="." />
  <exclude domain="file" path="." />
  <exclude domain="database" path="." />
  <exclude domain="sharedpref" path="." />
  <exclude domain="external" path="." />
  <!-- 699D-P: Android docs support device_* domains, but installed AGP Lint
       FullBackupContent falsely rejects them. Suppress only these entries. -->
  <exclude domain="device_root" path="." tools:ignore="FullBackupContent" />
  <exclude domain="device_file" path="." tools:ignore="FullBackupContent" />
  <exclude domain="device_database" path="." tools:ignore="FullBackupContent" />
  <exclude domain="device_sharedpref" path="." tools:ignore="FullBackupContent" />
</full-backup-content>
