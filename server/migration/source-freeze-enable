#!/usr/bin/env bash
set -Eeuo pipefail

BASE="$HOME/luba-server/migration-manager"
BIN="$BASE/bin"

"$BIN/source-freeze-precheck"

source "$BIN/source-lib"
source_load

RESULT="$(
source_psql -q -At -v ON_ERROR_STOP=1 -c "
BEGIN;

UPDATE lubanote_migration_internal.write_freeze_state
SET frozen=true,
    updated_at=now()
WHERE singleton=true;

DO \$\$
BEGIN
  IF NOT EXISTS (
    SELECT 1
    FROM lubanote_migration_internal.write_freeze_state
    WHERE singleton=true
      AND frozen=true
  ) THEN
    RAISE EXCEPTION 'SOURCE freeze state was not enabled';
  END IF;
END
\$\$;

COMMIT;

SELECT CASE
  WHEN frozen THEN 'SOURCE_FROZEN'
  ELSE 'SOURCE_NOT_FROZEN'
END
FROM lubanote_migration_internal.write_freeze_state
WHERE singleton=true;
"
)"

[ "$RESULT" = "SOURCE_FROZEN" ] || {
  echo "FREEZE_STATE=FAIL" >&2
  echo "DETAIL=$RESULT" >&2
  exit 1
}

echo "FREEZE_STATE=FROZEN"
echo "SOURCE_FROZEN"
