#!/usr/bin/env bash
set -Eeuo pipefail

BASE="$HOME/luba-server/migration-manager"
BIN="$BASE/bin"

source "$BIN/source-lib"
source_load

STATE="$(cat "$BASE/state/state" 2>/dev/null || true)"
RUN_ID="$(cat "$BASE/state/current_run" 2>/dev/null || true)"
RUN="$BASE/runs/$RUN_ID"
IDENTITY="$RUN/run-identity.env"

[ "$STATE" = "VERIFIED" ] || {
  echo "BLOKACE: Migration Manager neni VERIFIED. State=$STATE"
  exit 20
}

[ -n "$RUN_ID" ] && [ -f "$IDENTITY" ] || {
  echo "BLOKACE: VERIFIED run nema generickou run identity."
  exit 21
}

CURRENT_SOURCE_NAME="$SOURCE_NAME"
CURRENT_SOURCE_MODE="$SOURCE_MODE"
CURRENT_SOURCE_BACKEND_ID="${SOURCE_BACKEND_ID:-}"

# shellcheck disable=SC1090
source "$IDENTITY"

[ "${RUN_ID:-}" = "$(basename "$RUN")" ] || {
  echo "BLOKACE: RUN_ID identity nesouhlasi s current_run."
  exit 22
}

[ "${SOURCE_NAME:-}" = "$CURRENT_SOURCE_NAME" ] || {
  echo "BLOKACE: SOURCE_NAME se od VERIFIED runu zmenil."
  exit 23
}

[ "${SOURCE_MODE:-}" = "$CURRENT_SOURCE_MODE" ] || {
  echo "BLOKACE: SOURCE_MODE se od VERIFIED runu zmenil."
  exit 24
}

[ "${SOURCE_BACKEND_ID:-}" = "$CURRENT_SOURCE_BACKEND_ID" ] || {
  echo "BLOKACE: SOURCE_BACKEND_ID se od VERIFIED runu zmenil."
  exit 25
}

[ -n "$CURRENT_SOURCE_BACKEND_ID" ] || {
  echo "BLOKACE: SOURCE_BACKEND_ID je prazdny."
  exit 25
}

CONTROL_FILE="${SOURCE_CONTROL_STATE_FILE:-$HOME/luba-server/migration-bridge/control-state.json}"

if [ -r "$CONTROL_FILE" ]; then
  CONTROL="$(cat "$CONTROL_FILE")"
  CONTROL_FROM="local:$CONTROL_FILE"
else
  CONTROL_URL="${SOURCE_CONTROL_URL:-https://api.lubanote.com/control/v1/status}"
  CONTROL="$(curl -fsS "$CONTROL_URL")"
  CONTROL_FROM="$CONTROL_URL"
fi

python3 - "$CONTROL" "$CURRENT_SOURCE_BACKEND_ID" "$CONTROL_FROM" <<'PY'
import json, sys

data = json.loads(sys.argv[1])
expected = sys.argv[2]
origin = sys.argv[3]

def is_false(v):
    if v is False or v is None:
        return True
    if isinstance(v, (int, float)):
        return v == 0
    if isinstance(v, str):
        return v.strip().lower() in {"0", "false", "f", "no", "off", ""}
    return False

if data.get("mode") != "MAINTENANCE":
    print("BLOKACE: Control Point neni v MAINTENANCE.")
    print("Mode:", data.get("mode"))
    sys.exit(26)

if data.get("active_backend") != expected:
    print("BLOKACE: active_backend neodpovida SOURCE.")
    print("Expected:", expected)
    print("Actual:", data.get("active_backend"))
    sys.exit(27)

if not is_false(data.get("cutover_enabled")):
    print("BLOKACE: cutover_enabled musi byt pred CUTOVER false.")
    print("Actual:", data.get("cutover_enabled"))
    sys.exit(31)

print("PASS: VERIFIED run identity")
print("PASS: Control Point MAINTENANCE")
print("PASS: active_backend=" + expected)
print("PASS: cutover_enabled=false")
print("PASS: control_source=" + origin)
PY

unguarded="$(
source_psql -At -c "
WITH expected AS (
  SELECT c.oid
  FROM pg_class c
  JOIN pg_namespace n ON n.oid=c.relnamespace
  WHERE n.nspname='public'
    AND c.relkind='r'
    AND c.relname <> 'lubanote_server_status'
),
guarded AS (
  SELECT DISTINCT tgrelid
  FROM pg_trigger
  WHERE tgname='lubanote_migration_write_freeze_guard'
    AND NOT tgisinternal
)
SELECT count(*)
FROM expected e
LEFT JOIN guarded g ON g.tgrelid=e.oid
WHERE g.tgrelid IS NULL;
"
)"

[ "$unguarded" = "0" ] || {
  echo "BLOKACE: $unguarded datovych public tabulek nema freeze guard."
  exit 28
}

storage_guard="$(
source_psql -At -c "
SELECT count(*)
FROM pg_trigger t
JOIN pg_class c ON c.oid=t.tgrelid
JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='storage'
  AND c.relname='objects'
  AND t.tgname='lubanote_migration_write_freeze_guard'
  AND NOT t.tgisinternal;
"
)"

[ "$storage_guard" = "1" ] || {
  echo "BLOKACE: storage.objects freeze guard neni presne 1."
  exit 29
}

auth_guards="$(
source_psql -At -c "
SELECT count(*)
FROM pg_trigger t
JOIN pg_class c ON c.oid=t.tgrelid
JOIN pg_namespace n ON n.oid=c.relnamespace
WHERE n.nspname='auth'
  AND c.relname IN ('users','identities')
  AND t.tgname='lubanote_migration_auth_stable_guard'
  AND NOT tgisinternal;
"
)"

[ "$auth_guards" = "2" ] || {
  echo "BLOKACE: Auth stable guards nejsou presne 2."
  exit 30
}

echo "PASS: public data freeze coverage"
echo "PASS: storage.objects freeze guard"
echo "PASS: Auth stable guards"
echo "PRECHECK: PASS"
