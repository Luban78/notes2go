#!/usr/bin/env bash
set -Eeuo pipefail
umask 077
BASE="$HOME/luba-server/migration-manager"; BIN="$BASE/bin"; RUNS="$BASE/runs"
STATE_FILE="$BASE/state/state"; CURRENT_RUN_FILE="$BASE/state/current_run"
CONTROL="${SOURCE_CONTROL_STATE_FILE:-$HOME/luba-server/migration-bridge/control-state.json}"
fail(){ echo "BLOKACE: $*" >&2; return 1; }
normalize_backend_id(){ local out; out="$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._-')"; [ -n "$out" ] || return 1; printf '%s\n' "$out"; }

STATE="$(cat "$STATE_FILE" 2>/dev/null || true)"; BASELINE_ID="$(cat "$CURRENT_RUN_FILE" 2>/dev/null || true)"
BASELINE="$RUNS/$BASELINE_ID"; IDENTITY="$BASELINE/run-identity.env"; REPORT="$BASELINE/verify-report.txt"
[ "$STATE" = VERIFIED ] || { fail "Manager neni VERIFIED. State=$STATE"; exit 10; }
[ -n "$BASELINE_ID" ] || { fail "Chybi current_run"; exit 11; }
[ -f "$IDENTITY" ] || { fail "VERIFIED run nema run-identity.env"; exit 12; }
grep -qx 'VERIFY: PASS' "$REPORT" || { fail "baseline nema VERIFY: PASS"; exit 13; }
[ -d "$BASELINE/destination-before" ] || { fail "baseline nema destination-before"; exit 14; }

source "$BIN/source-lib"; source_load
CURRENT_SOURCE_NAME="$SOURCE_NAME"; CURRENT_SOURCE_MODE="$SOURCE_MODE"; CURRENT_SOURCE_BACKEND_ID="${SOURCE_BACKEND_ID:-}"
source "$BIN/destination-lib"; dest_load
CURRENT_DEST_NAME="$DEST_NAME"; CURRENT_DEST_MODE="$DEST_MODE"; CURRENT_DEST_BACKEND_ID="${DEST_BACKEND_ID:-$(normalize_backend_id "$DEST_NAME")}" 
# shellcheck disable=SC1090
source "$IDENTITY"
[ "${RUN_ID:-}" = "$BASELINE_ID" ] || { fail "RUN_ID identity nesouhlasi"; exit 15; }
[ "${SOURCE_NAME:-}" = "$CURRENT_SOURCE_NAME" ] && [ "${SOURCE_MODE:-}" = "$CURRENT_SOURCE_MODE" ] && [ "${SOURCE_BACKEND_ID:-}" = "$CURRENT_SOURCE_BACKEND_ID" ] || { fail "SOURCE se od VERIFY zmenil"; exit 16; }
[ "${DEST_NAME:-}" = "$CURRENT_DEST_NAME" ] && [ "${DEST_MODE:-}" = "$CURRENT_DEST_MODE" ] && [ "${DEST_BACKEND_ID:-}" = "$CURRENT_DEST_BACKEND_ID" ] || { fail "DEST se od VERIFY zmenil"; exit 17; }
SOURCE_BACKEND_ID="$CURRENT_SOURCE_BACKEND_ID"; DEST_BACKEND_ID="$CURRENT_DEST_BACKEND_ID"
[ -n "$SOURCE_BACKEND_ID" ] && [ -n "$DEST_BACKEND_ID" ] && [ "$SOURCE_BACKEND_ID" != "$DEST_BACKEND_ID" ] || { fail "neplatny smer"; exit 18; }

python3 - "$CONTROL" "$SOURCE_BACKEND_ID" <<'PY'
import json,sys
from pathlib import Path
d=json.loads(Path(sys.argv[1]).read_text()); src=sys.argv[2]
if d.get('mode')!='MAINTENANCE': raise SystemExit('BLOKACE: Control Point neni MAINTENANCE')
if d.get('active_backend')!=src: raise SystemExit('BLOKACE: active_backend neni SOURCE')
if d.get('cutover_enabled') is not False: raise SystemExit('BLOKACE: cutover_enabled neni false')
print('PASS: Control MAINTENANCE + SOURCE active')
PY

echo "=== CUTOVER 50E42 / 0: DEST client profile + freeze state ==="
CLIENT_PROFILE_JSON="$("$BIN/destination-client-profile")"
python3 - "$DEST_BACKEND_ID" "$CLIENT_PROFILE_JSON" <<'PY'
import json,sys
backend=sys.argv[1]; d=json.loads(sys.argv[2])
if d.get('backend_id')!=backend: raise SystemExit('BLOKACE: client profile backend mismatch')
if backend=='cloud':
    if d.get('static_profile') is not True: raise SystemExit('BLOKACE: cloud nema static_profile')
else:
    if not str(d.get('url','')).startswith(('https://','http://')) or not str(d.get('publishable_key','')).strip(): raise SystemExit('BLOKACE: DEST client profile neni kompletni')
print('PASS: DEST client profile')
PY
DEST_FREEZE_BEFORE="$("$BIN/destination-freeze-state")"
[ "$DEST_FREEZE_BEFORE" = true ] || [ "$DEST_FREEZE_BEFORE" = false ] || { fail "nelze zjistit DEST freeze state"; exit 19; }
echo "DEST_FREEZE_BEFORE=$DEST_FREEZE_BEFORE"

FINAL_ID="cutover-$(date -u +%Y%m%dT%H%M%SZ)"; FINAL="$RUNS/$FINAL_ID"
mkdir -p "$FINAL"; chmod 700 "$FINAL"; cp -a "$CONTROL" "$FINAL/control-state.before.json"
{
 echo "run_id=$FINAL_ID"; echo "parent_verified_run=$BASELINE_ID"; echo "created_utc=$(date -u +%FT%TZ)";
 echo "source_name=$CURRENT_SOURCE_NAME"; echo "source_mode=$CURRENT_SOURCE_MODE"; echo "source_backend_id=$SOURCE_BACKEND_ID";
 echo "destination_name=$CURRENT_DEST_NAME"; echo "destination_mode=$CURRENT_DEST_MODE"; echo "destination_backend_id=$DEST_BACKEND_ID";
 echo "dest_freeze_before=$DEST_FREEZE_BEFORE"; echo "manager=v3-50E42"; echo "phase=cutover";
} > "$FINAL/manifest"
{
 printf 'RUN_ID=%q\n' "$FINAL_ID"; printf 'SOURCE_NAME=%q\n' "$CURRENT_SOURCE_NAME"; printf 'SOURCE_MODE=%q\n' "$CURRENT_SOURCE_MODE"; printf 'SOURCE_BACKEND_ID=%q\n' "$SOURCE_BACKEND_ID";
 printf 'DEST_NAME=%q\n' "$CURRENT_DEST_NAME"; printf 'DEST_MODE=%q\n' "$CURRENT_DEST_MODE"; printf 'DEST_BACKEND_ID=%q\n' "$DEST_BACKEND_ID";
} > "$FINAL/run-identity.env"; chmod 600 "$FINAL/run-identity.env"
printf '%s\n' "$CLIENT_PROFILE_JSON" > "$FINAL/client-profile.json"; chmod 600 "$FINAL/client-profile.json"

FREEZE_ACTIVE=0; DEST_UNFROZEN=0
restore_dest_freeze(){
  if [ "$DEST_UNFROZEN" -eq 1 ]; then
    if [ "$DEST_FREEZE_BEFORE" = true ]; then "$BIN/destination-freeze-enable" >/dev/null; else "$BIN/destination-freeze-disable" >/dev/null; fi
  fi
}
rollback_after_failure(){
  local rc="$1"; trap - ERR; set +e
  echo "failed_utc=$(date -u +%FT%TZ)" >> "$FINAL/manifest"; echo "exit_code=$rc" >> "$FINAL/manifest"; touch "$FINAL/CUTOVER_FAILED"
  restore_dest_freeze
  if [ "$FREEZE_ACTIVE" -eq 1 ]; then
    echo "=== CUTOVER FAIL: automaticky navrat na PRIMARY ==="
    if "$BIN/restore-primary-normal" "$SOURCE_BACKEND_ID"; then
      printf 'IDLE\n' > "$STATE_FILE"; echo "rollback=PASS" >> "$FINAL/manifest"; echo "CUTOVER_ROLLBACK=PASS"; echo "State: IDLE"
    else
      printf 'ROLLBACK_REQUIRED\n' > "$STATE_FILE"; echo "rollback=FAIL" >> "$FINAL/manifest"; echo "CUTOVER_ROLLBACK=FAIL" >&2; exit 90
    fi
  fi
  exit "$rc"
}

echo "=== CUTOVER 50E42 / 1: SOURCE freeze ==="
"$BIN/source-freeze-enable"; FREEZE_ACTIVE=1; printf 'CUTTING_OVER\n' > "$STATE_FILE"; printf '%s\n' "$FINAL_ID" > "$CURRENT_RUN_FILE"
trap 'rollback_after_failure $?' ERR

echo "=== CUTOVER 50E42 / 2: fresh frozen SOURCE snapshot ==="
"$BIN/source-db-snapshot" "$FINAL"; "$BIN/source-manifests" "$FINAL"; "$BIN/source-storage-snapshot" "$FINAL"

echo "=== CUTOVER 50E42 / 3: DEST drift guard ==="
DRIFT="$FINAL/destination-precutover"; "$BIN/destination-manifests" "$FINAL" "$DRIFT"
for f in auth-stable.tsv storage-buckets.tsv storage-objects.tsv; do
  cmp -s "$BASELINE/destination-before/$f" "$DRIFT/$f" || { echo "BLOKACE: DEST $f se od PREPARE zmenil" >&2; false; }
done
echo "PASS: inactive DEST Auth/Storage beze zmeny od PREPARE"

echo "=== CUTOVER 50E42 / 4: final DEST checkpoint ==="
CP_PATH="$("$BIN/destination-checkpoint" "$FINAL_ID" | tee "$FINAL/checkpoint.log" | tail -n1)"; printf '%s\n' "$CP_PATH" > "$FINAL/checkpoint-path"

echo "=== CUTOVER 50E42 / 5: final public refresh ==="
touch "$FINAL/MUTATION_STARTED"; "$BIN/apply-public" "$FINAL"

echo "=== CUTOVER 50E42 / 5B: frozen Auth/Storage delta ==="
AFTER_PUBLIC="$FINAL/destination-after-public"; "$BIN/destination-manifests" "$FINAL" "$AFTER_PUBLIC"
if cmp -s "$FINAL/auth-stable.tsv" "$AFTER_PUBLIC/auth-stable.tsv" && cmp -s "$FINAL/storage-buckets.tsv" "$AFTER_PUBLIC/storage-buckets.tsv" && cmp -s "$FINAL/storage-objects.tsv" "$AFTER_PUBLIC/storage-objects.tsv"; then
  echo "AUTH_STORAGE_DELTA=SKIP_ALREADY_EQUAL"
else
  "$BIN/apply-auth-storage" "$FINAL"
fi

echo "=== CUTOVER 50E42 / 6: final VERIFY ==="
rm -f "$FINAL/pending-delta.env"
"$BIN/verify-run" "$FINAL"; grep -qx 'VERIFY: PASS' "$FINAL/verify-report.txt"

echo "=== CUTOVER 50E42 / 7: atomic SOURCE -> DEST switch ==="
python3 - "$CONTROL" "$SOURCE_BACKEND_ID" "$DEST_BACKEND_ID" "$FINAL/client-profile.json" <<'PY'
import json,os,sys
from datetime import datetime,timezone
from pathlib import Path
p=Path(sys.argv[1]); src=sys.argv[2]; dst=sys.argv[3]; profile=json.loads(Path(sys.argv[4]).read_text()); d=json.loads(p.read_text())
if d.get('mode')!='MAINTENANCE' or d.get('active_backend')!=src or d.get('cutover_enabled') is not False: raise SystemExit('Control state se pred switchem zmenil')
d['active_backend']=dst; d['cutover_enabled']=True
if dst=='cloud': d.pop('client_profile',None)
else: d['client_profile']=profile
d['updated_utc']=datetime.now(timezone.utc).isoformat(); t=p.with_name(p.name+'.cutover.tmp'); t.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n'); os.chmod(t,0o600); os.replace(t,p)
print('CUTOVER_SWITCH=PASS'); print('ACTIVE_BACKEND='+dst); print('CONTROL_POINT=MAINTENANCE')
PY

echo "=== CUTOVER 50E42 / 8: activate DEST writes ==="
"$BIN/destination-freeze-disable"; DEST_UNFROZEN=1
source "$BIN/destination-lib"; dest_load
read -r healthy total < <(dest_supabase_health); expected="$(dest_expected_health_total)"
[ "$healthy" = "$expected" ] && [ "$total" = "$expected" ] || false
echo "PASS: DEST health $healthy/$total"

echo "=== CUTOVER 50E42 / 9: publish NORMAL on DEST ==="
python3 - "$CONTROL" "$DEST_BACKEND_ID" <<'PY'
import json,os,sys
from datetime import datetime,timezone
from pathlib import Path
p=Path(sys.argv[1]); dst=sys.argv[2]; d=json.loads(p.read_text())
if d.get('mode')!='MAINTENANCE' or d.get('active_backend')!=dst or d.get('cutover_enabled') is not True: raise SystemExit('Control neni pripraven na NORMAL')
d['mode']='NORMAL'; d['updated_utc']=datetime.now(timezone.utc).isoformat(); t=p.with_name(p.name+'.normal.tmp'); t.write_text(json.dumps(d,ensure_ascii=False,indent=2)+'\n'); os.chmod(t,0o600); os.replace(t,p)
PY
printf 'CUTOVER_COMPLETE\n' > "$STATE_FILE"; touch "$FINAL/CUTOVER_COMPLETE"; trap - ERR

echo "CONTROL_POINT=NORMAL"; echo "ACTIVE_BACKEND=$DEST_BACKEND_ID"; echo "CUTOVER_ENABLED=true"
echo "CUTOVER=PASS"; echo "State: CUTOVER_COMPLETE"; echo "Run: $FINAL_ID"; echo "SOURCE_FROZEN=YES"; echo "DEST_WRITABLE=YES"; echo "ROLLBACK_PRIMARY=$SOURCE_BACKEND_ID"
