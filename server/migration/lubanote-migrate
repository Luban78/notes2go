#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

BASE="$HOME/luba-server/migration-manager"
STATE_DIR="$BASE/state"
RUNS_DIR="$BASE/runs"
BIN="$BASE/bin"
STATE_FILE="$STATE_DIR/state"
CURRENT_RUN_FILE="$STATE_DIR/current_run"

mkdir -p "$STATE_DIR" "$RUNS_DIR"
[ -f "$STATE_FILE" ] || printf 'IDLE\n' > "$STATE_FILE"

stav() { cat "$STATE_FILE"; }
set_state() { printf '%s\n' "$1" > "$STATE_FILE"; }
current_run() { [ -f "$CURRENT_RUN_FILE" ] && cat "$CURRENT_RUN_FILE" || true; }
latest_run() { find "$RUNS_DIR" -mindepth 1 -maxdepth 1 -type d 2>/dev/null | sort | tail -n 1 || true; }

normalize_backend_id() {
  local raw="$1"
  local out
  out="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr -cd 'a-z0-9._-')"
  [ -n "$out" ] || {
    echo "CHYBA: z DEST_NAME nelze odvodit DEST_BACKEND_ID." >&2
    return 1
  }
  printf '%s\n' "$out"
}

status() {
  echo "=== LubaNote Migration Manager V3 / 50E43 ==="
  echo "State: $(stav)"
  echo
  echo "=== BACKENDY ==="
  if [ -f "$BIN/source-lib" ] && [ -f "$BIN/destination-lib" ]; then
    ( source "$BIN/source-lib"; source_load >/dev/null 2>&1; echo "SOURCE:      ${SOURCE_NAME:-?} [${SOURCE_BACKEND_ID:-?}] / ${SOURCE_MODE:-?}" ) || echo "SOURCE:      CONFIG ERROR"
    ( source "$BIN/destination-lib"; dest_load >/dev/null 2>&1; echo "DESTINATION: ${DEST_NAME:-?} [${DEST_BACKEND_ID:-?}] / ${DEST_MODE:-?}" ) || echo "DESTINATION: CONFIG ERROR"
  fi
  echo
  echo "=== CUTOVER ==="
  case "$(stav)" in
    VERIFIED)
      echo "READY (MAINTENANCE zapne CUTOVER automaticky)"
      ;;
    CUTTING_OVER)
      echo "IN PROGRESS"
      ;;
    CUTOVER_COMPLETE)
      echo "COMPLETE"
      ;;
    ROLLBACK_REQUIRED)
      echo "BLOCKED: ROLLBACK_REQUIRED"
      ;;
    *)
      echo "LOCKED (vyzaduje VERIFIED)"
      ;;
  esac
  echo
  echo "=== AKTUALNI RUN ==="
  r="$(current_run)"
  if [ -n "$r" ]; then echo "$r"; else echo "zadny"; fi
  echo
  echo "=== POSLEDNI RUN ==="
  l="$(latest_run)"
  if [ -n "$l" ]; then basename "$l"; else echo "zadny"; fi
  if [ -n "$r" ] && [ -f "$RUNS_DIR/$r/verify-report.txt" ]; then
    echo
    echo "=== VERIFY REPORT ==="
    cat "$RUNS_DIR/$r/verify-report.txt"
  fi
}

prepare() {
  current="$(stav)"
  if [ "$current" != "IDLE" ]; then
    echo "CHYBA: PREPARE lze spustit pouze ze stavu IDLE."
    echo "Aktualni stav: $current"
    exit 1
  fi

  # 50E40B: vsechny smerove/control invarianty overit PRED vytvorenim runu,
  # PRED PREPARING a PRED jakoukoli mutaci DEST.
  source "$BIN/source-lib"
  source_load

  source "$BIN/destination-lib"
  dest_load

  : "${SOURCE_BACKEND_ID:?chybi SOURCE_BACKEND_ID}"
  DEST_BACKEND_ID="${DEST_BACKEND_ID:-$(normalize_backend_id "$DEST_NAME")}"

  [[ "$SOURCE_BACKEND_ID" =~ ^[A-Za-z0-9._-]+$ ]] || {
    echo "BLOKACE: SOURCE_BACKEND_ID obsahuje nepovolene znaky." >&2
    exit 1
  }
  [[ "$DEST_BACKEND_ID" =~ ^[A-Za-z0-9._-]+$ ]] || {
    echo "BLOKACE: DEST_BACKEND_ID obsahuje nepovolene znaky." >&2
    exit 1
  }

  [ "$SOURCE_BACKEND_ID" != "$DEST_BACKEND_ID" ] || {
    echo "BLOKACE: SOURCE a DEST backend jsou stejne: $SOURCE_BACKEND_ID" >&2
    echo "PREPARE nebyl zahajen; State zustava IDLE." >&2
    exit 40
  }

  CONTROL="${SOURCE_CONTROL_STATE_FILE:-$HOME/luba-server/migration-bridge/control-state.json}"
  [ -f "$CONTROL" ] || {
    echo "BLOKACE: chybi control-state.json: $CONTROL" >&2
    exit 41
  }

  python3 - "$CONTROL" "$SOURCE_BACKEND_ID" <<'PYCTRL'
import json, sys
from pathlib import Path

p = Path(sys.argv[1])
source = sys.argv[2]
data = json.loads(p.read_text(encoding="utf-8"))

if data.get("mode") != "NORMAL":
    raise SystemExit("BLOKACE: PREPARE vyzaduje Control Point NORMAL")
if data.get("active_backend") != source:
    raise SystemExit(
        "BLOKACE: active_backend=%s, ale SOURCE_BACKEND_ID=%s" %
        (data.get("active_backend"), source)
    )
if data.get("cutover_enabled") is not False:
    raise SystemExit("BLOKACE: PREPARE vyzaduje cutover_enabled=false")

print("PASS: PREPARE direction invariant SOURCE != DEST")
print("PASS: PREPARE Control Point NORMAL + SOURCE active")
PYCTRL

  run_id="prepare-$(date -u +%Y%m%dT%H%M%SZ)"
  run_dir="$RUNS_DIR/$run_id"
  mkdir -p "$run_dir"
  chmod 700 "$run_dir"
  printf '%s\n' "$run_id" > "$CURRENT_RUN_FILE"
  set_state PREPARING

  {
    echo "run_id=$run_id"
    echo "created_utc=$(date -u +%FT%TZ)"
    echo "source_name=$SOURCE_NAME"
    echo "source_mode=$SOURCE_MODE"
    echo "source_backend_id=$SOURCE_BACKEND_ID"
    echo "destination_name=$DEST_NAME"
    echo "destination_mode=$DEST_MODE"
    echo "destination_backend_id=$DEST_BACKEND_ID"
    echo "manager=v3-50E40"
  } > "$run_dir/manifest"

  {
    printf 'RUN_ID=%q\n' "$run_id"
    printf 'SOURCE_NAME=%q\n' "$SOURCE_NAME"
    printf 'SOURCE_MODE=%q\n' "$SOURCE_MODE"
    printf 'SOURCE_BACKEND_ID=%q\n' "$SOURCE_BACKEND_ID"
    printf 'DEST_NAME=%q\n' "$DEST_NAME"
    printf 'DEST_MODE=%q\n' "$DEST_MODE"
    printf 'DEST_BACKEND_ID=%q\n' "$DEST_BACKEND_ID"
  } > "$run_dir/run-identity.env"

  chmod 600 "$run_dir/run-identity.env"

  on_error() {
    rc=$?
    trap - ERR
    echo "failed_utc=$(date -u +%FT%TZ)" >> "$run_dir/manifest" || true
    echo "exit_code=$rc" >> "$run_dir/manifest" || true
    if [ -f "$run_dir/MUTATION_STARTED" ]; then
      set_state PREPARE_FAILED
      echo "PREPARE selhal PO zahajeni mutace. Stav=PREPARE_FAILED. Automaticky rollback se zamerne nespousti." >&2
    else
      set_state IDLE
      echo "PREPARE byl zastaven pred mutaci. Stav vracen na IDLE." >&2
    fi
    exit "$rc"
  }
  trap on_error ERR

  echo "=== PREPARE V3 / 1: source preflight ==="
  "$BIN/source-preflight"
  echo "=== PREPARE V3 / 2: source DB snapshot ==="
  "$BIN/source-db-snapshot" "$run_dir"
  echo "=== PREPARE V3 / 3: source manifests ==="
  "$BIN/source-manifests" "$run_dir"
  "$BIN/filter-public-local" "$run_dir"
  echo "=== PREPARE V3 / 4: source Storage snapshot ==="
  "$BIN/source-storage-snapshot" "$run_dir"
  echo "=== PREPARE V3 / 5: destination precheck ==="
  pre="$run_dir/destination-before"
  "$BIN/destination-manifests" "$run_dir" "$pre"

  AUTH_DELTA=0; STORAGE_BUCKET_DELTA=0; STORAGE_OBJECT_DELTA=0
  cmp -s "$run_dir/auth-stable.tsv" "$pre/auth-stable.tsv" || AUTH_DELTA=1
  cmp -s "$run_dir/storage-buckets.tsv" "$pre/storage-buckets.tsv" || STORAGE_BUCKET_DELTA=1
  cmp -s "$run_dir/storage-objects.tsv" "$pre/storage-objects.tsv" || STORAGE_OBJECT_DELTA=1
  {
    echo "AUTH_DELTA=$AUTH_DELTA"
    echo "STORAGE_BUCKET_DELTA=$STORAGE_BUCKET_DELTA"
    echo "STORAGE_OBJECT_DELTA=$STORAGE_OBJECT_DELTA"
  } > "$run_dir/pending-delta.env"
  chmod 600 "$run_dir/pending-delta.env"
  if [ "${AUTH_DELTA}${STORAGE_BUCKET_DELTA}${STORAGE_OBJECT_DELTA}" = "000" ]; then
    echo "PASS: Auth + Storage metadata shodna; final delta nebude nutna"
  else
    echo "PASS: Auth/Storage rozdil zaznamenan; aplikace je odlozena az do frozen CUTOVER"
    echo "DELTA: auth=$AUTH_DELTA buckets=$STORAGE_BUCKET_DELTA objects=$STORAGE_OBJECT_DELTA"
  fi

  echo "=== PREPARE V3 / 6: rollback checkpoint ==="
  cp_path="$("$BIN/destination-checkpoint" "$run_id" | tee "$run_dir/checkpoint.log" | tail -n 1)"
  printf '%s\n' "$cp_path" > "$run_dir/checkpoint-path"

  echo "=== PREPARE V3 / 7: public data apply ==="
  touch "$run_dir/MUTATION_STARTED"
  "$BIN/apply-public" "$run_dir"

  printf 'PREPARED\n' > "$STATE_FILE"
  echo "prepared_utc=$(date -u +%FT%TZ)" >> "$run_dir/manifest"
  trap - ERR

  echo
  echo "PREPARE: PASS"
  echo "State: PREPARED"
  echo "Run: $run_id"
  echo "Rollback: $cp_path"
  echo "Dalsi krok: lubanote-migrate verify"
}

verify() {
  current="$(stav)"
  [ "$current" = "PREPARED" ] || {
    echo "CHYBA: VERIFY vyzaduje PREPARED. Aktualni stav: $current"
    exit 1
  }

  run_id="$(current_run)"
  [ -n "$run_id" ] || {
    echo "CHYBA: chybi current_run"
    exit 1
  }

  run_dir="$RUNS_DIR/$run_id"
  set_state VERIFYING

  if "$BIN/verify-run" "$run_dir"; then
    set_state VERIFIED
    echo "verified_utc=$(date -u +%FT%TZ)" >> "$run_dir/manifest"
    echo
    echo "VERIFY: PASS"
    echo "State: VERIFIED"
    echo "CUTOVER je pripraven; MAINTENANCE/Drain zapne CUTOVER automaticky."
  else
    set_state PREPARED
    echo
    echo "VERIFY: FAIL"
    echo "State vracen na PREPARED."
    exit 1
  fi
}

cutover() {
  current="$(stav)"
  [ "$current" = "VERIFIED" ] || {
    echo "CHYBA: CUTOVER vyzaduje VERIFIED. Aktualni stav: $current"
    exit 1
  }

  exec "$BIN/cutover-final"
}

prepare_server() {
  source "$BIN/destination-lib"
  dest_load
  if [ "$DEST_MODE" = "ssh" ]; then
    "$BIN/destination-prepare-server"
  else
    echo "PREPARE_SERVER=SKIP"
    echo "DEST_MODE=$DEST_MODE"
  fi
}

case "${1:-status}" in
  prepare-server) prepare_server ;;
  status) status ;;
  prepare) prepare ;;
  verify) verify ;;
  cutover) cutover ;;
  *)
    echo "Pouziti:"
    echo "  lubanote-migrate prepare-server"
    echo "  lubanote-migrate status"
    echo "  lubanote-migrate prepare"
    echo "  lubanote-migrate verify"
    echo "  lubanote-migrate cutover"
    exit 1
    ;;
esac
