#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

BASE="/home/luban78/luba-server/migration-manager"
CONTROL_FILE="/home/luban78/luba-server/migration-bridge/control-state.json"
CONFIG_DIR="$BASE/config"

fail() {
  echo "CHYBA: $*" >&2
  exit 1
}

usage() {
  cat >&2 <<'USAGE'
Pouziti:
  source-primary-invariant state --backend ID [--config PATH]
  source-primary-invariant check --backend ID [--config PATH]
  source-primary-invariant recover --backend ID [--config PATH]
  source-primary-invariant freeze --backend ID [--config PATH]
  source-primary-invariant check-frozen --backend ID [--config PATH]
USAGE
  exit 2
}

COMMAND="${1:-}"
shift || true
case "$COMMAND" in
  state|check|recover|freeze|check-frozen) ;;
  *) usage ;;
esac

BACKEND_ID=""
CONFIG_PATH=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --backend)
      [ "$#" -ge 2 ] || usage
      BACKEND_ID="$2"
      shift 2
      ;;
    --config)
      [ "$#" -ge 2 ] || usage
      CONFIG_PATH="$2"
      shift 2
      ;;
    *) usage ;;
  esac
done

read_env_key() {
  local file="$1" key="$2"
  [ -f "$file" ] || return 0
  python3 - "$file" "$key" <<'PY'
import sys
path, key = sys.argv[1], sys.argv[2]
try:
    with open(path, "r", encoding="utf-8") as f:
        for raw in f:
            line = raw.strip()
            if not line or line.startswith("#") or "=" not in line:
                continue
            k, v = line.split("=", 1)
            if k.strip() != key:
                continue
            v = v.strip()
            if len(v) >= 2 and v[0] == v[-1] and v[0] in ("'", '"'):
                v = v[1:-1]
            print(v)
            break
except OSError:
    pass
PY
}

if [ -z "$CONFIG_PATH" ]; then
  [ -n "$BACKEND_ID" ] || fail "Chybi --backend nebo --config."
  if [ -f "$CONFIG_DIR/source-$BACKEND_ID.env" ]; then
    CONFIG_PATH="$CONFIG_DIR/source-$BACKEND_ID.env"
  elif [ "$BACKEND_ID" = "cloud" ] && [ -f "$CONFIG_DIR/source-cloud.env" ]; then
    CONFIG_PATH="$CONFIG_DIR/source-cloud.env"
  elif [ -f "$CONFIG_DIR/source.env" ]; then
    SOURCE_ENV_BACKEND="$(read_env_key "$CONFIG_DIR/source.env" SOURCE_BACKEND_ID)"
    if [ "$SOURCE_ENV_BACKEND" = "$BACKEND_ID" ]; then
      CONFIG_PATH="$CONFIG_DIR/source.env"
    fi
  fi
fi

[ -n "$CONFIG_PATH" ] || fail "Nelze jednoznacne vybrat SOURCE konfiguraci pro backend '${BACKEND_ID:-?}'."
[ -f "$CONFIG_PATH" ] || fail "SOURCE konfigurace neexistuje: $CONFIG_PATH"

set -a
# shellcheck disable=SC1090
source "$CONFIG_PATH"
set +a

if [ -z "${SOURCE_BACKEND_ID:-}" ]; then
  case "$(basename "$CONFIG_PATH")" in
    source-cloud.env) SOURCE_BACKEND_ID="cloud" ;;
  esac
fi

if [ -n "$BACKEND_ID" ] && [ -n "${SOURCE_BACKEND_ID:-}" ] && [ "$SOURCE_BACKEND_ID" != "$BACKEND_ID" ]; then
  fail "SOURCE_BACKEND_ID='$SOURCE_BACKEND_ID' neodpovida pozadovanemu backendu '$BACKEND_ID'."
fi

if [ -z "$BACKEND_ID" ]; then
  BACKEND_ID="${SOURCE_BACKEND_ID:-}"
fi
[ -n "$BACKEND_ID" ] || fail "Nelze urcit SOURCE_BACKEND_ID."

if [ -z "${SOURCE_MODE:-}" ]; then
  case "$(basename "$CONFIG_PATH")" in
    source-cloud.env) SOURCE_MODE="remote" ;;
    *) fail "V $CONFIG_PATH chybi SOURCE_MODE." ;;
  esac
fi

SOURCE_DB_NAME="${SOURCE_DB_NAME:-postgres}"
SOURCE_DB_USER="${SOURCE_DB_USER:-postgres}"
SOURCE_DB_PORT="${SOURCE_DB_PORT:-5432}"
SOURCE_DB_SSLMODE="${SOURCE_DB_SSLMODE:-require}"
SOURCE_SSH_PORT="${SOURCE_SSH_PORT:-22}"

safe_word() {
  [[ "$1" =~ ^[A-Za-z0-9_.-]+$ ]]
}

safe_word "$SOURCE_DB_NAME" || fail "Neocekavany SOURCE_DB_NAME."
safe_word "$SOURCE_DB_USER" || fail "Neocekavany SOURCE_DB_USER."

run_psql() {
  local sql="$1"
  case "$SOURCE_MODE" in
    docker)
      [ -n "${SOURCE_DOCKER_CONTAINER:-}" ] || fail "Chybi SOURCE_DOCKER_CONTAINER."
      safe_word "$SOURCE_DOCKER_CONTAINER" || fail "Neocekavany SOURCE_DOCKER_CONTAINER."
      printf '%s\n' "$sql" | docker exec -i "$SOURCE_DOCKER_CONTAINER" \
        psql -U "$SOURCE_DB_USER" -d "$SOURCE_DB_NAME" -X -q -v ON_ERROR_STOP=1 -At
      ;;
    ssh)
      [ -n "${SOURCE_SSH_HOST:-}" ] || fail "Chybi SOURCE_SSH_HOST."
      [ -n "${SOURCE_SSH_USER:-}" ] || fail "Chybi SOURCE_SSH_USER."
      [ -n "${SOURCE_DOCKER_CONTAINER:-}" ] || fail "Chybi SOURCE_DOCKER_CONTAINER."
      safe_word "$SOURCE_SSH_HOST" || fail "Neocekavany SOURCE_SSH_HOST."
      safe_word "$SOURCE_SSH_USER" || fail "Neocekavany SOURCE_SSH_USER."
      safe_word "$SOURCE_DOCKER_CONTAINER" || fail "Neocekavany SOURCE_DOCKER_CONTAINER."
      printf '%s\n' "$sql" | ssh \
        -p "$SOURCE_SSH_PORT" \
        -o BatchMode=yes \
        -o ConnectTimeout=10 \
        "$SOURCE_SSH_USER@$SOURCE_SSH_HOST" \
        docker exec -i "$SOURCE_DOCKER_CONTAINER" \
        psql -U "$SOURCE_DB_USER" -d "$SOURCE_DB_NAME" -X -q -v ON_ERROR_STOP=1 -At
      ;;
    remote)
      [ -n "${SOURCE_DB_HOST:-}" ] || fail "Chybi SOURCE_DB_HOST."
      [ -n "${SOURCE_DB_PASSWORD:-}" ] || fail "Chybi SOURCE_DB_PASSWORD."
      printf '%s\n' "$sql" | docker run --rm -i \
        -e PGPASSWORD="$SOURCE_DB_PASSWORD" \
        -e PGSSLMODE="$SOURCE_DB_SSLMODE" \
        postgres:17-alpine \
        psql -h "$SOURCE_DB_HOST" -p "$SOURCE_DB_PORT" \
        -U "$SOURCE_DB_USER" -d "$SOURCE_DB_NAME" \
        -X -q -v ON_ERROR_STOP=1 -At
      ;;
    *)
      fail "Nepodporovany SOURCE_MODE='$SOURCE_MODE'."
      ;;
  esac
}

freeze_state() {
  local raw
  raw="$(run_psql "SELECT count(*)::text || '|' || COALESCE(bool_or(frozen)::text,'null') FROM lubanote_migration_internal.write_freeze_state WHERE singleton=true;" | tail -n 1 | tr -d '\r')"
  case "$raw" in
    '1|t') printf 'FROZEN\n' ;;
    '1|f') printf 'UNFROZEN\n' ;;
    *) fail "Neplatny write_freeze_state ($raw)." ;;
  esac
}

set_freeze() {
  local value="$1"
  run_psql "BEGIN; UPDATE lubanote_migration_internal.write_freeze_state SET frozen=$value, updated_at=now() WHERE singleton=true; COMMIT;" >/dev/null
}

write_probe() {
  local sql
  read -r -d '' sql <<'SQL' || true
BEGIN;
DO $lubanote_probe$
DECLARE
  n public.notes%ROWTYPE;
  result jsonb;
BEGIN
  SELECT n0.* INTO n
  FROM public.notes n0
  WHERE n0.deleted_at IS NULL
    AND NOT EXISTS (
      SELECT 1 FROM public.note_collaborators c WHERE c.note_id = n0.id
    )
    AND public.lubanote_user_has_data_access(n0.user_id)
  ORDER BY n0.updated_at DESC NULLS LAST, n0.id
  LIMIT 1;

  IF n.id IS NULL THEN
    RAISE EXCEPTION 'LUBANOTE_WRITE_PROBE_NO_ELIGIBLE_PRIVATE_NOTE';
  END IF;

  PERFORM set_config('request.jwt.claim.sub', n.user_id::text, true);
  PERFORM set_config('request.jwt.claim.role', 'authenticated', true);
  PERFORM set_config(
    'request.jwt.claims',
    jsonb_build_object('sub', n.user_id::text, 'role', 'authenticated')::text,
    true
  );

  EXECUTE 'SET LOCAL ROLE authenticated';

  SELECT public.save_note_safe(
    n.id,
    n.data,
    n.revision,
    false,
    NULL
  ) INTO result;

  IF COALESCE((result->>'ok')::boolean, false) IS NOT TRUE THEN
    RAISE EXCEPTION 'LUBANOTE_WRITE_PROBE_SAVE_FAILED: %', result;
  END IF;
END
$lubanote_probe$;
ROLLBACK;
SQL
  run_psql "$sql" >/dev/null
}

check_guard_coverage_frozen() {
  local raw
  raw="$(run_psql "
WITH expected AS (
  SELECT c.oid
  FROM pg_class c
  JOIN pg_namespace n ON n.oid=c.relnamespace
  WHERE n.nspname='public'
    AND c.relkind='r'
    AND c.relname <> 'lubanote_server_status'
), guarded AS (
  SELECT DISTINCT tgrelid
  FROM pg_trigger
  WHERE tgname='lubanote_migration_write_freeze_guard'
    AND NOT tgisinternal
), stats AS (
  SELECT
    (SELECT frozen FROM lubanote_migration_internal.write_freeze_state WHERE singleton=true) AS frozen,
    (SELECT count(*) FROM expected e LEFT JOIN guarded g ON g.tgrelid=e.oid WHERE g.tgrelid IS NULL) AS public_unguarded,
    (SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='storage' AND c.relname='objects' AND t.tgname='lubanote_migration_write_freeze_guard' AND NOT t.tgisinternal) AS storage_guards,
    (SELECT count(*) FROM pg_trigger t JOIN pg_class c ON c.oid=t.tgrelid JOIN pg_namespace n ON n.oid=c.relnamespace WHERE n.nspname='auth' AND c.relname IN ('users','identities') AND t.tgname='lubanote_migration_auth_stable_guard' AND NOT t.tgisinternal) AS auth_guards
)
SELECT frozen::text || '|' || public_unguarded::text || '|' || storage_guards::text || '|' || auth_guards::text FROM stats;
" | tail -n 1 | tr -d '\r')"
  [ "$raw" = "true|0|1|2" ] || [ "$raw" = "t|0|1|2" ] || fail "Freeze coverage neni kompletni ($raw)."
}

case "$COMMAND" in
  state)
    freeze_state
    ;;
  freeze)
    set_freeze true
    [ "$(freeze_state)" = "FROZEN" ] || fail "SOURCE se nepodarilo zmrazit."
    echo "SOURCE_BACKEND_ID=$BACKEND_ID"
    echo "FREEZE_STATE=FROZEN"
    ;;
  recover)
    set_freeze false
    echo "SOURCE_BACKEND_ID=$BACKEND_ID"
    echo "FREEZE_STATE=UNFROZEN"
    write_probe
    echo "WRITE_PROBE=PASS"
    [ "$(freeze_state)" = "UNFROZEN" ] || fail "Freeze state se po write probe neocekavane zmenil."
    echo "FREEZE_STATE_UNCHANGED=PASS"
    echo "SOURCE_WRITABLE=YES"
    ;;
  check)
    [ "$(freeze_state)" = "UNFROZEN" ] || fail "SOURCE je FROZEN."
    echo "SOURCE_BACKEND_ID=$BACKEND_ID"
    echo "SOURCE_CONFIG=$(basename "$CONFIG_PATH")"
    echo "FREEZE_STATE=UNFROZEN"
    write_probe
    echo "WRITE_PROBE=PASS"
    [ "$(freeze_state)" = "UNFROZEN" ] || fail "Freeze state se po write probe neocekavane zmenil."
    echo "FREEZE_STATE_UNCHANGED=PASS"
    echo "SOURCE_WRITABLE=YES"
    ;;
  check-frozen)
    [ "$(freeze_state)" = "FROZEN" ] || fail "SOURCE neni FROZEN."
    check_guard_coverage_frozen
    echo "SOURCE_BACKEND_ID=$BACKEND_ID"
    echo "FREEZE_STATE=FROZEN"
    echo "FREEZE_COVERAGE=PASS"
    ;;
esac
