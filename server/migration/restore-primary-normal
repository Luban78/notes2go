#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

BASE="$HOME/luba-server/migration-manager"
BIN="$BASE/bin"
CONTROL="${SOURCE_CONTROL_STATE_FILE:-$HOME/luba-server/migration-bridge/control-state.json}"
PRIMARY_BACKEND="${1:-}"

fail() {
  echo "PRIMARY_RESTORE=FAIL" >&2
  echo "REASON=$*" >&2
  exit 1
}

[ -n "$PRIMARY_BACKEND" ] || fail "Pouziti: restore-primary-normal BACKEND_ID"
[[ "$PRIMARY_BACKEND" =~ ^[A-Za-z0-9._-]+$ ]] || fail "Neplatny BACKEND_ID"
[ -f "$CONTROL" ] || fail "Chybi control-state.json: $CONTROL"

echo "=== PRIMARY RESTORE / 1: SOURCE UNFREEZE + WRITE PROBE ==="
"$BIN/source-freeze-disable"

echo "=== PRIMARY RESTORE / 2: PUBLISH NORMAL PRIMARY ==="
python3 - "$CONTROL" "$PRIMARY_BACKEND" <<'PY'
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path

p = Path(sys.argv[1])
primary = sys.argv[2]
data = json.loads(p.read_text(encoding="utf-8"))

data["mode"] = "NORMAL"
data["active_backend"] = primary
data["cutover_enabled"] = False
profile = data.get("client_profile")
if primary == "cloud":
    data.pop("client_profile", None)
elif not isinstance(profile, dict) or profile.get("backend_id") != primary:
    data.pop("client_profile", None)
data["updated_utc"] = datetime.now(timezone.utc).isoformat()

tmp = p.with_name(p.name + ".restore-primary.tmp")
tmp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
os.chmod(tmp, 0o600)
os.replace(tmp, p)
PY

python3 - "$CONTROL" "$PRIMARY_BACKEND" <<'PY'
import json, sys
from pathlib import Path

data = json.loads(Path(sys.argv[1]).read_text(encoding="utf-8"))
primary = sys.argv[2]

if data.get("mode") != "NORMAL":
    raise SystemExit("Control Point neni NORMAL")
if data.get("active_backend") != primary:
    raise SystemExit("active_backend neni PRIMARY")
if data.get("cutover_enabled") is not False:
    raise SystemExit("cutover_enabled neni false")

print("CONTROL_POINT=NORMAL")
print("ACTIVE_BACKEND=" + primary)
print("CUTOVER_ENABLED=false")
print("PRIMARY_RESTORE=PASS")
PY
