#!/usr/bin/env bash
set -Eeuo pipefail
umask 077

BASE="$HOME/luba-server/migration-manager"
CONTROL="$HOME/luba-server/migration-bridge/control-state.json"
HELPER="$BASE/bin/source-primary-invariant"
BACKEND="${1:-cloud}"
STAMP="$(date -u +%Y%m%dT%H%M%SZ)"
BACKUP="$BASE/backups/primary-restore-$STAMP"

[ -x "$HELPER" ] || { echo "CHYBA: chybi $HELPER" >&2; exit 1; }
[ -f "$CONTROL" ] || { echo "CHYBA: chybi $CONTROL" >&2; exit 1; }
[[ "$BACKEND" =~ ^[A-Za-z0-9_.-]+$ ]] || { echo "CHYBA: neplatny backend id" >&2; exit 1; }

mkdir -p "$BACKUP"
cp -a "$CONTROL" "$BACKUP/control-state.json.before"
INITIAL_FREEZE="$($HELPER state --backend "$BACKEND")"
printf '%s\n' "$INITIAL_FREEZE" > "$BACKUP/freeze-state.before"

rollback() {
  rc=$?
  echo "CHYBA: restore PRIMARY selhal, vracim puvodni Control Point." >&2
  cp -a "$BACKUP/control-state.json.before" "$CONTROL" || true
  if [ "$INITIAL_FREEZE" = "FROZEN" ]; then
    if ! "$HELPER" freeze --backend "$BACKEND" >/dev/null 2>&1; then
      echo "KRITICKE: nepodarilo se vratit puvodni FROZEN stav SOURCE. Zkontroluj write_freeze_state." >&2
    fi
  fi
  exit "$rc"
}
trap rollback ERR

echo "=== PRIMARY RESTORE: $BACKEND ==="
echo "Checkpoint: $BACKUP"

echo "1/3 Obnovuji SOURCE zapisovatelnost..."
"$HELPER" recover --backend "$BACKEND"

echo "2/3 Publikuji NORMAL + active_backend=$BACKEND..."
python3 - "$CONTROL" "$BACKEND" <<'PY'
import json, os, sys
from datetime import datetime, timezone
from pathlib import Path
p = Path(sys.argv[1])
backend = sys.argv[2]
d = json.loads(p.read_text(encoding="utf-8"))
d["ok"] = True
d["version"] = int(d.get("version") or 1)
d["mode"] = "NORMAL"
d["active_backend"] = backend
d["cutover_enabled"] = False
d["updated_utc"] = datetime.now(timezone.utc).isoformat()
tmp = p.with_suffix(".json.primary-restore.tmp")
with tmp.open("w", encoding="utf-8") as f:
    json.dump(d, f, ensure_ascii=False, indent=2)
    f.write("\n")
    f.flush()
    os.fsync(f.fileno())
os.chmod(tmp, 0o600)
os.replace(tmp, p)
PY

echo "3/3 Finalni invariant..."
"$HELPER" check --backend "$BACKEND"
python3 - "$CONTROL" "$BACKEND" <<'PY'
import json, sys
with open(sys.argv[1], "r", encoding="utf-8") as f:
    d = json.load(f)
expected = sys.argv[2]
assert d.get("mode") == "NORMAL", d
assert d.get("active_backend") == expected, d
assert d.get("cutover_enabled") is False, d
print("CONTROL_POINT=NORMAL")
print("ACTIVE_BACKEND=" + expected)
print("CUTOVER_ENABLED=false")
PY

trap - ERR
echo "PRIMARY_RESTORE=PASS"
echo "Rollback checkpoint: $BACKUP"
