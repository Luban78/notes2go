# LubaNote Server / BI-2A
# Zkopiruj na server jako: lubanote-server.env

# Verejna domena backendu. DNS A/AAAA musi smerovat na VPS pred startem HTTPS.
LUBANOTE_BACKEND_DOMAIN=api.example.com

# Verejna URL aplikace pro Auth redirecty.
LUBANOTE_APP_URL=https://example.com/

# E-mail pro Let's Encrypt upozorneni.
CERTBOT_EMAIL=admin@example.com

# Kam se self-hosted Supabase nainstaluje.
INSTALL_DIR=/opt/lubanote-supabase

# Pripnuta a otestovatelna self-hosted konfigurace podle aktualni dokumentace Supabase.
SUPABASE_REF=self-hosted/v0.8.2
